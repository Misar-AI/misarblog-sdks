{
  "name": "@misarblog/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript/JavaScript SDK for the Misar.Blog developer API \u2014 articles, drafts, series, comments, follows, reactions, AI completion/titles, image generation, search, analytics, plan and trial.",
  "type": "module",
  "license": "MIT",
  "author": "Misar AI <hello@misar.io>",
  "homepage": "https://docs.misar.io/blog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarblog-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misarblog-sdks/issues"
  },
  "keywords": [
    "misarblog",
    "blog",
    "sdk",
    "api",
    "publishing",
    "content",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/index.iife.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^24.0.0"
  }
}
