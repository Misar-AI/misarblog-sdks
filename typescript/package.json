{
  "name": "@misarblog/sdk",
  "version": "5.0.4",
  "description": "Typed client for misar.blog, a hosted blogging platform: publish and schedule Markdown articles, manage drafts and series, read comments, reactions, follows and analytics, generate SEO titles, completions and AI cover images, and search. Node 18+ and browsers; retry with back-off, typed plan-limit errors, iframe embed helpers.",
  "type": "module",
  "license": "MIT",
  "author": "Misar.AI <hello@misar.io>",
  "homepage": "https://www.misar.blog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarblog-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misarblog-sdks/issues"
  },
  "keywords": [
    "misarblog",
    "misar",
    "blog",
    "blogging",
    "publishing",
    "cms",
    "headless-cms",
    "articles",
    "markdown",
    "content-api",
    "api-client",
    "sdk",
    "typescript",
    "seo",
    "newsletter"
  ],
  "engines": {
    "node": ">=18.20.8"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/index.iife.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^24.1.3"
  }
}
