<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MisarBlog</AssemblyName>
    <RootNamespace>MisarBlog</RootNamespace>

    <!-- NuGet metadata -->
    <PackageId>MisarBlog</PackageId>
    <Version>5.0.3</Version>
    <Authors>Misar AI</Authors>
    <Company>Misar AI Technology Pvt Ltd</Company>
    <Description>C# client for misar.blog, a hosted blogging platform: publish and schedule Markdown articles, manage drafts and series, read comments, reactions, follows and analytics, generate SEO titles, completions and AI cover images, and search. .NET 8 async/await; retry with back-off, typed plan-limit exceptions, iframe embed URLs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.misar.blog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Misar-AI/misarblog-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>misarblog;misar;blog;blogging;publishing;cms;headless-cms;articles;markdown;content-api;api-client;sdk;seo</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Tests/ is its own project and references xUnit. Without this exclusion the
    SDK's default **/*.cs glob pulls the test sources into the library build,
    which then fails on the missing xUnit reference — the same trap the MisarMail
    and MisarReach projects were caught in.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
