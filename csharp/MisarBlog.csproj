<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MisarBlog</AssemblyName>
    <RootNamespace>MisarBlog</RootNamespace>

    <!-- NuGet metadata -->
    <PackageId>MisarBlog</PackageId>
    <Version>1.1.0</Version>
    <Authors>Misar AI</Authors>
    <Company>Misar AI Technology Pvt Ltd</Company>
    <Description>Official C# SDK for the Misar.Blog developer API — articles, drafts, series, comments, follows, reactions, AI, images, search, analytics, plan/trial. Full 25-operation coverage with async/await.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.misar.io/blog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Misar-AI/misarblog-sdks</RepositoryUrl>
    <PackageTags>misarblog;blog;sdk;api;publishing;content</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--
    Tests/ is its own project and references xUnit. Without this exclusion the
    SDK's default **/*.cs glob pulls the test sources into the library build,
    which then fails on the missing xUnit reference — the same trap the MisarMail
    and MisarReach projects were caught in.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
