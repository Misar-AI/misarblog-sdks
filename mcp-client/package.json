  "homepage": "https://docs.misar.io/blog/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarblog-sdks.git",
    "directory": "mcp-client"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misarblog-sdks/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
